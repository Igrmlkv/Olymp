{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Callbacks passed to page.evaluate run in the browser, so they need DOM
    // types even though the suite itself runs in Node.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
